# ==============================================================================
# PASSIVE WEALTH RECONSTRUCTION ENGINE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# WARNING: Do not commit the '.env' file containing real secrets to version control!

# ------------------------------------------------------------------------------
# 1. Application Configurations
# ------------------------------------------------------------------------------
# Toggle debugging mode (true/false)
DEBUG=true

# Environment level (development, staging, production)
ENVIRONMENT=development

# Logger severity level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Secret key used for cryptographic signing, JWT tokens, and sessions
# Generate a secure one using: openssl rand -hex 32
SECRET_KEY=your_app_secret_key_here

# ------------------------------------------------------------------------------
# 2. Database Configurations (PostgreSQL)
# ------------------------------------------------------------------------------
# Individual components used by Docker Compose and database initialization
POSTGRES_USER=your_db_username_here
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=pwre_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Primary Database Connection URL
# Format: postgresql+asyncpg://[user]:[password]@[host]:[port]/[database_name]
# Note: Use 'db' as the host if running inside the Docker network (e.g. Celery / FastAPI container)
# Use 'localhost' if running the FastAPI application directly on your local host machine.
DATABASE_URL=postgresql+asyncpg://your_db_username_here:your_db_password_here@localhost:5432/pwre_db

# ------------------------------------------------------------------------------
# 3. Redis & Celery Configurations
# ------------------------------------------------------------------------------
# Redis connection URL (used for application caching)
# Note: Use 'redis' as the host if running inside Docker.
REDIS_URL=redis://localhost:6379/0

# Celery Message Broker URL
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery Result Backend URL
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Third-Party Financial API Keys & Feeds
# ------------------------------------------------------------------------------
# NSE (National Stock Exchange) India API configurations
NSE_API_KEY=your_nse_api_key_here
NSE_REQUEST_TIMEOUT=30

# BSE (Bombay Stock Exchange) India API configurations
BSE_API_KEY=your_bse_api_key_here

# Yahoo Finance scraper / API timeout settings (in seconds)
YAHOO_FINANCE_TIMEOUT=30
